<Window x:Class="Example.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Example"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="1100"
        KeyDown="Window_KeyDown">
    <!-- Grid-Layout: linke Spalte für das Spielfeld, rechte Spalte für Score/Info -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="2" />
        </Grid.ColumnDefinitions>

        <!-- Spielfeld (Canvas) links; hier werden Wände, Figur und Goodies gezeichnet -->
        <Canvas x:Name="Spielfeld"
                Grid.Column="0"
                Background="Black"
                Margin="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />


    </Grid>
</Window>
